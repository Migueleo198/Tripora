# Copiar a .env y rellenar. El archivo .env no se sube a git
DB_ROOT_PASSWORD=cambia_esta_root
DB_PASSWORD=cambia_esta

# Dirección pública de la web (para los enlaces de los correos)
URL_SITIO=http://localhost:8080
PUERTO_WEB=8080

# Gmail: cuenta y "contraseña de aplicación". Vacío = los correos se guardan en App/logs/correos.log
CORREO_USUARIO=
CORREO_PASSWORD=
